---
import Frame from './Frame.astro';
---
<Frame id="w-loc" title="قانون جيوب التمام: فيثاغورس المعمّم" en="c² = a² + b² − 2ab cos C">
  <div class="controls">
    <label><span class="ltr">a = <output data-o="a"></output></span><input type="range" min="2" max="9" step="0.5" value="6" data-i="a" /></label>
    <label><span class="ltr">b = <output data-o="b"></output></span><input type="range" min="2" max="9" step="0.5" value="5" data-i="b" /></label>
    <label>الزاوية بينهما <span class="ltr">C = <output data-o="C"></output>°</span><input type="range" min="10" max="170" value="60" data-i="C" /></label>
  </div>
  <canvas aria-label="مثلث بضلعين والزاوية بينهما"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-loc')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -10, xmax: 10, ymin: -1, ymax: 10 });
  const v = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!.value);
  const D = Math.PI / 180;
  function draw() {
    const a = v('a'), b = v('b'), C = v('C');
    for (const k of ['a', 'b', 'C']) root.querySelector(`[data-o="${k}"]`)!.textContent = String(v(k));
    // C عند الأصل، والضلع a على المحور الأفقي إلى B، والضلع b إلى A
    const Bx = a, Ax = b * Math.cos(C * D), Ay = b * Math.sin(C * D);
    plot.fit(0.5);
    const x0 = Math.min(0, Ax) - 2.5, W = Math.max(Math.max(a, Ax) + 3 - x0, (b + 1.6) / 0.5);
    plot.view = { xmin: x0, xmax: x0 + W, ymin: -0.1 * W, ymax: 0.4 * W };
    plot.clear();
    const c = Math.sqrt(a * a + b * b - 2 * a * b * Math.cos(C * D));
    const { ctx } = plot;
    ctx.fillStyle = css('--accent-soft');
    ctx.beginPath(); ctx.moveTo(plot.X(0), plot.Y(0)); ctx.lineTo(plot.X(Bx), plot.Y(0)); ctx.lineTo(plot.X(Ax), plot.Y(Ay)); ctx.closePath(); ctx.fill();
    plot.seg(0, 0, Bx, 0, css('--plot-alt'), 3);
    plot.seg(0, 0, Ax, Ay, css('--plot-curve'), 3);
    plot.seg(Bx, 0, Ax, Ay, css('--plot-hot'), 3.5);
    // مثلث قائم مرجعي (بزاوية 90) بالخط المتقطع
    plot.seg(0, 0, 0, b, css('--muted'), 1.2, [4, 4]);
    plot.seg(Bx, 0, 0, b, css('--muted'), 1.2, [4, 4]);
    plot.param((t) => 0.9 * Math.cos(t), (t) => 0.9 * Math.sin(t), 0, C * D, css('--ink'), 1.8);
    plot.label(Bx / 2, -0.08 * W, `a = ${a}`, css('--plot-alt'), 'center');
    plot.label(Ax / 2 - 0.3, Ay / 2, `b = ${b}`, css('--plot-curve'), 'right');
    plot.label((Bx + Ax) / 2 + 0.3, Ay / 2, `c ≈ ${fmt(c, 2)}`, css('--plot-hot'), 'left');
    plot.label(0.9, 0.2, 'C', css('--ink'));
    const pyth = Math.sqrt(a * a + b * b);
    const s = (a + b + c) / 2;
    const area = Math.sqrt(Math.max(0, s * (s - a) * (s - b) * (s - c)));
    const cosC = Math.cos(C * D);
    out.innerHTML =
      `<p>${tex(`$c^2 = ${a}^2 + ${b}^2 - 2(${a})(${b})\\cos ${C}^\\circ = ${fmt(a * a + b * b, 2)} ${cosC >= 0 ? '-' : '+'} ${fmt(Math.abs(2 * a * b * cosC), 2)} = ${fmt(c * c, 2)}$`)}، إذن ${tex(`$c \\approx ${fmt(c, 3)}$`)}.</p>` +
      `<p>لو كانت ${tex('$C = 90^\\circ$')} (المثلث المتقطع) لكان ${tex(`$c = \\sqrt{a^2 + b^2} \\approx ${fmt(pyth, 3)}$`)}. الحد ${tex('$-2ab\\cos C$')} هو التصحيح: ${C < 90 ? 'يطرح لأن C حادة فيقصر الضلع' : C > 90 ? 'يضيف لأن C منفرجة (جيب التمام سالب) فيطول الضلع' : 'صفر، فالقانون هو فيثاغورس'}.</p>` +
      `<p>المساحة بصيغة هيرون: ${tex(`$s = \\tfrac{a + b + c}{2} \\approx ${fmt(s, 3)}$`)}، و ${tex(`$\\sqrt{s(s-a)(s-b)(s-c)} \\approx ${fmt(area, 3)}$`)}، وتساوي ${tex(`$\\tfrac12 ab\\sin C \\approx ${fmt(0.5 * a * b * Math.sin(C * D), 3)}$`)}.</p>`;
  }
  root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
  onRedraw(canvas, draw);
</script>
