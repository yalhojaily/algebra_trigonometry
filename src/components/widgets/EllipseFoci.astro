---
import Frame from './Frame.astro';
---
<Frame id="w-ell" title="القطع الناقص: مجموع البعدين ثابت" en="d₁ + d₂ = 2a">
  <div class="controls">
    <label><span class="ltr">a = <output data-o="a"></output></span><input type="range" min="1" max="7" step="0.5" value="5" data-i="a" /></label>
    <label><span class="ltr">b = <output data-o="b"></output></span><input type="range" min="1" max="7" step="0.5" value="3" data-i="b" /></label>
    <label>موضع النقطة <span class="ltr">θ = <output data-o="t"></output>°</span><input type="range" min="0" max="360" value="50" data-i="t" /></label>
  </div>
  <canvas aria-label="قطع ناقص وبؤرتاه"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-ell')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -10, xmax: 10, ymin: -6, ymax: 6 });
  const v = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!.value);
  function draw() {
    const a = v('a'), b = v('b'), t = (v('t') * Math.PI) / 180;
    for (const k of ['a', 'b', 't']) root.querySelector(`[data-o="${k}"]`)!.textContent = String(v(k));
    plot.fit(0.62);
    plot.view = { xmin: -8 / 0.62, xmax: 8 / 0.62, ymin: -8, ymax: 8 };
    plot.clear();
    plot.grid(1, 2);
    const horiz = a >= b;
    const big = Math.max(a, b), small = Math.min(a, b);
    const c = Math.sqrt(big * big - small * small);
    plot.param((s) => a * Math.cos(s), (s) => b * Math.sin(s), 0, 2 * Math.PI, css('--plot-curve'), 3);
    const F1: [number, number] = horiz ? [-c, 0] : [0, -c], F2: [number, number] = horiz ? [c, 0] : [0, c];
    const P: [number, number] = [a * Math.cos(t), b * Math.sin(t)];
    plot.seg(P[0], P[1], F1[0], F1[1], css('--plot-hot'), 2.2);
    plot.seg(P[0], P[1], F2[0], F2[1], css('--plot-alt'), 2.2);
    plot.dot(F1[0], F1[1], css('--plot-hot'), 6); plot.dot(F2[0], F2[1], css('--plot-alt'), 6);
    plot.dot(P[0], P[1], css('--ink'), 5);
    const d1 = Math.hypot(P[0] - F1[0], P[1] - F1[1]), d2 = Math.hypot(P[0] - F2[0], P[1] - F2[1]);
    const e = c / big;
    out.innerHTML =
      `<p>${tex(`$\\dfrac{x^2}{${a * a}} + \\dfrac{y^2}{${b * b}} = 1$`)}: المحور الأكبر ${horiz ? 'أفقي' : 'رأسي'} وطوله ${tex(`$2\\cdot${big} = ${2 * big}$`)}، والأصغر ${tex(`$${2 * small}$`)}.</p>` +
      `<p>البؤرتان ${tex(`$(${horiz ? `\\pm ${fmt(c, 3)}, 0` : `0, \\pm ${fmt(c, 3)}`})$`)} حيث ${tex(`$c^2 = ${big * big} - ${small * small}$`)}. للنقطة المختارة: ${tex(`$d_1 + d_2 = ${fmt(d1, 3)} + ${fmt(d2, 3)} = ${fmt(d1 + d2, 3)} = 2\\cdot${big}$`)} دائمًا.</p>` +
      `<p>الاختلاف المركزي ${tex(`$e = \\tfrac{c}{${big}} \\approx ${fmt(e, 3)}$`)}: ${e < 0.05 ? 'قريب من الصفر فالشكل يكاد يكون دائرة.' : e > 0.8 ? 'قريب من 1 فالقطع ممدود جدًا.' : 'بين 0 و 1؛ كلما زاد صار القطع أكثر استطالة.'}</p>`;
  }
  root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
  onRedraw(canvas, draw);
</script>
