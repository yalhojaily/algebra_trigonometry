---
import Frame from './Frame.astro';
---
<Frame id="w-ref" title="الزاوية المرجعية" en="Reference angles">
  <div class="controls">
    <label>الزاوية <span class="ltr">θ = <output data-o="t"></output>°</span><input type="range" min="0" max="360" step="15" value="150" data-i="t" /></label>
    <label class="chk"><input type="checkbox" data-i="fine" /> خطوة درجة واحدة</label>
  </div>
  <canvas aria-label="دائرة الوحدة والزاوية المرجعية"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-ref')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -1.8, xmax: 1.8, ymin: -1.3, ymax: 1.3 });
  const inp = root.querySelector<HTMLInputElement>('[data-i="t"]')!;
  const fine = root.querySelector<HTMLInputElement>('[data-i="fine"]')!;
  fine.addEventListener('change', () => { inp.step = fine.checked ? '1' : '15'; draw(); });
  const EX: Record<number, [string, string]> = {
    0: ['0', '1'], 30: ['\\tfrac{1}{2}', '\\tfrac{\\sqrt{3}}{2}'], 45: ['\\tfrac{\\sqrt{2}}{2}', '\\tfrac{\\sqrt{2}}{2}'], 60: ['\\tfrac{\\sqrt{3}}{2}', '\\tfrac{1}{2}'], 90: ['1', '0'],
  };
  const TN: Record<number, string> = { 0: '0', 30: '\\tfrac{\\sqrt{3}}{3}', 45: '1', 60: '\\sqrt{3}' };
  function draw() {
    const t = Number(inp.value);
    root.querySelector('[data-o="t"]')!.textContent = String(t);
    plot.fit(0.62);
    const w = plot.w, h = plot.h;
    const half = (1.3 * w) / h;
    plot.view = { xmin: -half, xmax: half, ymin: -1.3, ymax: 1.3 };
    plot.clear();
    plot.grid(0.5, 2);
    const r = (t * Math.PI) / 180, c = Math.cos(r), s = Math.sin(r);
    plot.param(Math.cos, Math.sin, 0, 2 * Math.PI, css('--muted'), 1.5);
    // المثلث المرجعي
    const { ctx } = plot;
    ctx.fillStyle = css('--accent-soft');
    ctx.beginPath(); ctx.moveTo(plot.X(0), plot.Y(0)); ctx.lineTo(plot.X(c), plot.Y(0)); ctx.lineTo(plot.X(c), plot.Y(s)); ctx.closePath(); ctx.fill();
    plot.param((u) => 0.25 * Math.cos(u), (u) => 0.25 * Math.sin(u), 0, r, css('--plot-hot'), 2);
    // قوس الزاوية المرجعية عند محور x
    const from = c >= 0 ? (s >= 0 ? 0 : 2 * Math.PI) : Math.PI;
    plot.param((u) => 0.45 * Math.cos(u), (u) => 0.45 * Math.sin(u), Math.min(from, r), Math.max(from, r), css('--plot-alt'), 3);
    plot.seg(0, 0, c, s, css('--plot-curve'), 3);
    plot.seg(c, 0, c, s, css('--plot-alt'), 2, [4, 3]);
    plot.dot(c, s, css('--plot-hot'), 6);
    const m = t % 360;
    const ref = m <= 90 ? m : m <= 180 ? 180 - m : m <= 270 ? m - 180 : 360 - m;
    const rule = m <= 90 ? `${tex(`$\\theta' = \\theta = ${m}^\\circ$`)} (الربع الأول)` : m <= 180 ? `${tex(`$\\theta' = 180^\\circ - ${m}^\\circ = ${ref}^\\circ$`)} (الربع الثاني)` : m <= 270 ? `${tex(`$\\theta' = ${m}^\\circ - 180^\\circ = ${ref}^\\circ$`)} (الربع الثالث)` : `${tex(`$\\theta' = 360^\\circ - ${m}^\\circ = ${ref}^\\circ$`)} (الربع الرابع)`;
    const sg = (v: number) => (Math.abs(v) < 1e-9 ? '' : v < 0 ? '-' : '');
    let vals = '';
    if (ref in EX && (ref !== 90)) {
      const [sv, cv] = EX[ref];
      const sinT = Math.abs(s) < 1e-9 ? '0' : `${sg(s)}${sv}`, cosT = Math.abs(c) < 1e-9 ? '0' : `${sg(c)}${cv}`;
      const tanT = Math.abs(c) < 1e-9 ? '\\text{undefined}' : Math.abs(s) < 1e-9 ? '0' : `${s * c < 0 ? '-' : ''}${TN[ref]}`;
      vals = `<p>قيم دقيقة: ${tex(`$\\sin ${t}^\\circ = ${sinT},\\ \\cos ${t}^\\circ = ${cosT},\\ \\tan ${t}^\\circ = ${tanT}$`)}</p>`;
    } else if (ref === 90) {
      vals = `<p>زاوية ربعية: ${tex(`$\\sin ${t}^\\circ = ${fmt(s, 0)},\\ \\cos ${t}^\\circ = ${fmt(c, 0)}$`)}، والظل ${Math.abs(c) < 1e-9 ? 'غير معرّف' : tex('$0$')}.</p>`;
    } else {
      vals = `<p>${tex(`$\\sin ${t}^\\circ \\approx ${fmt(s, 4)},\\ \\cos ${t}^\\circ \\approx ${fmt(c, 4)}$`)}، وهي بالمقدار نفسه ${tex(`$\\sin ${ref}^\\circ \\approx ${fmt(Math.abs(s), 4)}$`)} و ${tex(`$\\cos ${ref}^\\circ \\approx ${fmt(Math.abs(c), 4)}$`)} مع إشارة الربع.</p>`;
    }
    out.innerHTML =
      `<p>الزاوية المرجعية ${tex("$\\theta'$")} هي الزاوية الحادة بين الضلع النهائي و<strong>محور x</strong> (القوس الأزرق): ${rule}.</p>` + vals +
      `<p>القاعدة: قيمة الدالة عند ${tex('$\\theta$')} = قيمتها عند ${tex("$\\theta'$")}، ثم ضع الإشارة المناسبة للربع. ضلعا المثلث الملوّن هما ${tex('$|\\cos\\theta|$')} و ${tex('$|\\sin\\theta|$')}.</p>`;
  }
  inp.addEventListener('input', draw);
  onRedraw(canvas, draw);
</script>
