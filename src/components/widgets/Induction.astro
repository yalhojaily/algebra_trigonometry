---
import Frame from './Frame.astro';
---
<Frame id="w-ind" title="الاستقراء بصريًا: مجموع الأعداد الفردية" en="1 + 3 + ⋯ + (2n − 1) = n²">
  <div class="controls">
    <label><span class="ltr">n = <output data-o="n"></output></span><input type="range" min="1" max="10" value="4" data-i="n" /></label>
  </div>
  <canvas aria-label="مربع مكوّن من أشكال على هيئة حرف L"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-ind')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: 0, xmax: 11, ymin: 0, ymax: 11 });
  const inp = root.querySelector<HTMLInputElement>('[data-i="n"]')!;
  const cols = ['--plot-curve', '--plot-alt'];
  function draw() {
    const n = Number(inp.value);
    root.querySelector('[data-o="n"]')!.textContent = String(n);
    plot.fit(0.5);
    const H = 11, W = H / 0.5;
    plot.view = { xmin: n / 2 - W / 2, xmax: n / 2 + W / 2, ymin: n / 2 - H / 2, ymax: n / 2 + H / 2 };
    plot.clear();
    const { ctx } = plot;
    for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
      const layer = Math.max(i, j); // الطبقة L رقم layer + 1
      const last = layer === n - 1;
      ctx.fillStyle = last ? css('--plot-hot') : css(cols[layer % 2]);
      ctx.globalAlpha = last ? 0.95 : 0.7;
      const x0 = plot.X(i + 0.06), x1 = plot.X(i + 0.94), y0 = plot.Y(j + 0.94), y1 = plot.Y(j + 0.06);
      ctx.fillRect(x0, y0, x1 - x0, y1 - y0);
    }
    ctx.globalAlpha = 1;
    const sum = Array.from({ length: n }, (_, k) => 2 * k + 1);
    out.innerHTML =
      `<p>${tex(`$${sum.join(' + ')} = ${n * n} = ${n}^2$`)}</p>` +
      `<p>كل لون شكل على هيئة حرف L فيه عدد فردي من المربعات. إذا كان المربع ${tex(`$${n - 1} \\times ${n - 1}$`)} مكتملًا (الفرض ${tex('$P(k)$')})، فإضافة L البرتقالية ذات ${tex(`$2k + 1 = ${2 * n - 1}$`)} مربعًا تكمل مربعًا ${tex(`$${n} \\times ${n}$`)}: ${tex(`$k^2 + (2k + 1) = (k + 1)^2$`)}. هذه هي خطوة الاستقراء.</p>` +
      `<p>ومع الأساس ${tex('$P(1): 1 = 1^2$')} تصح العبارة لكل ${tex('$n$')}، كأحجار دومينو يُسقط كل منها التالي.</p>`;
  }
  inp.addEventListener('input', draw);
  onRedraw(canvas, draw);
</script>
