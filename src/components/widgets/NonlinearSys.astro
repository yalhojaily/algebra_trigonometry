---
import Frame from './Frame.astro';
---
<Frame id="w-nls" title="نظام غير خطي: دائرة ومستقيم أو قطع مكافئ" en="0, 1, or 2 real solutions">
  <div class="controls">
    <label>المنحنى الثاني
      <span class="seg" dir="ltr" data-i="k"><button type="button" data-v="line" aria-pressed="true">y = mx + b</button><button type="button" data-v="par">y = x² + b</button></span>
    </label>
    <label>نصف قطر الدائرة <span class="ltr">r = <output data-o="r"></output></span><input type="range" min="1" max="6" step="0.5" value="4" data-i="r" /></label>
    <label><span class="ltr">m = <output data-o="m"></output></span><input type="range" min="-3" max="3" step="0.5" value="1" data-i="m" /></label>
    <label><span class="ltr">b = <output data-o="b"></output></span><input type="range" min="-8" max="8" step="0.5" value="2" data-i="b" /></label>
  </div>
  <canvas aria-label="دائرة ومنحنى ونقاط التقاطع"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-nls')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -10, xmax: 10, ymin: -8, ymax: 8 });
  let k = 'line';
  root.querySelectorAll<HTMLButtonElement>('[data-i="k"] button').forEach((btn) =>
    btn.addEventListener('click', () => {
      k = btn.dataset.v!;
      root.querySelectorAll('[data-i="k"] button').forEach((o) => o.setAttribute('aria-pressed', String(o === btn)));
      draw();
    }),
  );
  const v = (n: string) => Number(root.querySelector<HTMLInputElement>(`[data-i="${n}"]`)!.value);
  function draw() {
    const r = v('r'), m = v('m'), b = v('b');
    for (const n of ['r', 'm', 'b']) root.querySelector(`[data-o="${n}"]`)!.textContent = String(v(n));
    plot.fit(0.62);
    plot.view = { xmin: -8 / 0.62, xmax: 8 / 0.62, ymin: -8, ymax: 8 };
    plot.clear();
    plot.grid(1, 2);
    plot.param((t) => r * Math.cos(t), (t) => r * Math.sin(t), 0, 2 * Math.PI, css('--plot-curve'), 3);
    const pts: [number, number][] = [];
    let work = '';
    if (k === 'line') {
      plot.fn((x) => m * x + b, css('--plot-alt'), 3);
      // x² + (mx + b)² = r² ← (1 + m²)x² + 2mbx + b² − r² = 0
      const A = 1 + m * m, B = 2 * m * b, C = b * b - r * r;
      const D = B * B - 4 * A * C;
      if (D >= -1e-9) { const s = Math.sqrt(Math.max(0, D)); [(-B - s) / (2 * A), (-B + s) / (2 * A)].forEach((x) => { if (!pts.some((p) => Math.abs(p[0] - x) < 1e-9)) pts.push([x, m * x + b]); }); }
      work = `بالتعويض ${tex(`$y = ${m}x + ${b}$`)} في الدائرة: ${tex(`$${fmt(A, 2)}x^2 ${B < 0 ? '-' : '+'} ${fmt(Math.abs(B), 2)}x ${C < 0 ? '-' : '+'} ${fmt(Math.abs(C), 2)} = 0$`)}، والمميز ${tex(`$${fmt(D, 2)}$`)}.`;
    } else {
      plot.fn((x) => x * x + b, css('--plot-alt'), 3);
      // x² + y² = r² و x² = y − b ← y − b + y² = r² ← y² + y − b − r² = 0
      const D = 1 + 4 * (b + r * r);
      if (D >= 0) {
        [(-1 + Math.sqrt(D)) / 2, (-1 - Math.sqrt(D)) / 2].forEach((y) => {
          const x2 = y - b;
          if (x2 > 1e-9) { pts.push([Math.sqrt(x2), y], [-Math.sqrt(x2), y]); } else if (Math.abs(x2) <= 1e-9) pts.push([0, y]);
        });
      }
      work = `بحذف ${tex('$x^2$')} (لأن ${tex(`$x^2 = y ${b < 0 ? '+' : '-'} ${Math.abs(b)}$`)}): ${tex(`$y^2 + y - ${fmt(b + r * r, 2)} = 0$`)}. كل قيمة لـ ${tex('$y$')} تعطي قيمتين لـ ${tex('$x$')} إذا كان ${tex('$y - b > 0$')}.`;
    }
    pts.forEach(([x, y]) => plot.dot(x, y, css('--plot-hot'), 6));
    out.innerHTML =
      `<p>${tex(`$\\begin{cases} x^2 + y^2 = ${r * r} \\\\ ${k === 'line' ? `y = ${m}x ${b < 0 ? '-' : '+'} ${Math.abs(b)}` : `y = x^2 ${b < 0 ? '-' : '+'} ${Math.abs(b)}`} \\end{cases}$`)}</p>` +
      `<p>${work}</p>` +
      `<p><strong>${pts.length === 0 ? 'لا حلول حقيقية' : pts.length === 1 ? 'حل واحد (تماس)' : `${pts.length} حلول حقيقية`}</strong>${pts.length ? ': ' + pts.map(([x, y]) => tex(`$(${fmt(x, 2)}, ${fmt(y, 2)})$`)).join('، ') : ' (قد توجد حلول مركبة غير حقيقية)'}.</p>`;
  }
  root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
  onRedraw(canvas, draw);
</script>
