---
import Base from '../layouts/Base.astro';
import { chapters, lessonSlug } from '../data/curriculum';
const base = import.meta.env.BASE_URL;
const area = (id: string) =>
  ['5', '6', '7', '8'].includes(id) ? 'علم المثلثات' : id === '10' ? 'هندسة تحليلية' : id === 'A' ? 'ملاحق' : id === 'R' ? 'مراجعة' : 'جبر';
const readyIds = chapters.filter((c) => c.status === 'ready').flatMap((c) => c.sections.map((s) => s.id));
---
<Base title="الجبر الجامعي وعلم المثلثات | شرح عربي تفاعلي">
  <section class="hero">
    <div class="hero-text">
      <h1>الجبر الجامعي وعلم المثلثات، مشروحًا بالعربية خطوة بخطوة</h1>
      <p class="lede">
        كل قسم من الكتاب درس مستقل: شرح بالحدس أولًا، ثم القاعدة، ثم أمثلة يُكشف حلها خطوة خطوة، وأداة تفاعلية تحرّك فيها المعاملات وترى أثرها،
        وتمارين جديدة في كل مرة تُصحَّح فورًا. المصطلحات مكتوبة بالعربية والإنجليزية معًا لتقرأ الكتاب الأصلي بسهولة.
      </p>
      <div class="cta" data-progress-wrap>
        <a class="btn primary" href={`${base}lessons/${lessonSlug(readyIds[0])}/`} data-continue={readyIds.join(',')}>ابدأ من الدرس الأول</a>
        <a class="btn" href={`${base}glossary/`}>قائمة المصطلحات</a>
        <span class="prog">
          <span class="bar" data-progress-bar><i></i></span>
          <span>أنهيت <span data-progress-count={readyIds.join(',')}>0 من {readyIds.length}</span> دروس</span>
        </span>
      </div>
    </div>
    <svg class="hero-plot" viewBox="0 0 320 240" role="img" aria-label="قطع مكافئ يقطع محور x في نقطتين">
      <defs>
        <pattern id="g" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="var(--line)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="320" height="240" fill="url(#g)" />
      <path d="M0 160H320M100 0V240" stroke="var(--muted)" stroke-width="1.5" />
      <path class="curve" d="M30 20 Q160 300 290 20" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" />
      <path d="M0 200 L320 40" fill="none" stroke="var(--def)" stroke-width="2" stroke-dasharray="7 6" />
      <circle cx="68" cy="160" r="6" fill="var(--plot-hot)" />
      <circle cx="252" cy="160" r="6" fill="var(--plot-hot)" />
      <text x="160" y="232" text-anchor="middle" font-family="Noto Sans" font-size="14" fill="var(--muted)" direction="ltr">b² − 4ac &gt; 0</text>
    </svg>
  </section>

  <section class="map" aria-labelledby="map-h">
    <div class="map-head">
      <h2 id="map-h">فصول الكتاب</h2>
      <p class="map-note">الفصول من R إلى 5 جاهزة الآن، وبقية الفصول تُضاف تباعًا.</p>
    </div>
    <ul class="cards">
      {[...chapters.filter((c) => c.status === 'ready'), ...chapters.filter((c) => c.status !== 'ready')].map((ch) => {
        const ids = ch.sections.map((s) => s.id);
        return (
          <li class={`card ${ch.status}`} data-progress-wrap={ch.status === 'ready' ? '' : undefined}>
            <span class="num" aria-hidden="true">{ch.id}</span>
            <p class="kind">
              <span>{area(ch.id)}</span>
              {ch.status === 'soon' ? <span class="tag-soon">قريبًا</span> : <span class="tag-ready">جاهز</span>}
            </p>
            <h3>
              <a class="title" href={`${base}chapters/${ch.id}/`}>
                <span class="sr">{ch.id === 'A' ? '' : `الفصل ${ch.id}: `}</span>{ch.ar}
              </a>
            </h3>
            <p class="en" lang="en" dir="ltr">{ch.en}</p>
            <p class="blurb">{ch.blurb}</p>
            {ch.status === 'ready' ? (
              <>
                <ol class="secs">
                  {ch.sections.map((sec) => (
                    <li data-progress-id={sec.id}>
                      <a href={`${base}lessons/${lessonSlug(sec.id)}/`}>
                        <span class="sid">{sec.id}</span>
                        <span>{sec.ar}</span>
                      </a>
                    </li>
                  ))}
                </ol>
                <div class="foot">
                  <span class="bar" data-progress-bar><i></i></span>
                  <span>أنهيت <span data-progress-count={ids.join(',')}>0 من {ids.length}</span></span>
                </div>
              </>
            ) : (
              <p class="foot muted">{ch.sections.length} أقسام</p>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <script>
    import { getProgress, paintProgress } from '../lib/progress';
    paintProgress();
    const a = document.querySelector<HTMLAnchorElement>('[data-continue]');
    if (a) {
      const ids = a.dataset.continue!.split(',');
      const p = getProgress();
      const done = ids.filter((id) => p[id]).length;
      const nextId = ids.find((id) => !p[id]);
      if (done > 0 && nextId) {
        a.href = a.href.replace(/lessons\/[^/]+\/$/, `lessons/${nextId.replace('.', '-')}/`);
        a.textContent = `تابع من ${nextId}`;
      } else if (done === ids.length) a.textContent = 'راجع الدروس';
    }
  </script>
</Base>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4.5rem) 1rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3rem); line-height: 1.45; max-width: 18ch; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 58ch; margin: 1.2rem 0 1.6rem; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .prog { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: var(--muted); }
  .bar { width: 90px; height: 6px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--ok); }
  .hero-plot { width: 100%; max-width: 420px; justify-self: center; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); }
  .curve { stroke-dasharray: 520; stroke-dashoffset: 520; animation: draw 1.6s 0.2s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  .map { max-width: 1240px; margin: 0 auto; padding: 2.5rem 1rem 0; }
  .map-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 1.4rem; }
  .map-note { color: var(--muted); margin: 0; }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.3rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    min-height: 15rem;
  }
  .num {
    position: absolute;
    inset-inline-end: 0.9rem;
    top: 0.2rem;
    font: 700 4.2rem/1 var(--font-en);
    color: var(--line);
    pointer-events: none;
  }
  .kind { position: relative; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.6rem; font: 600 0.78rem var(--font-head); color: var(--muted); }
  .tag-ready { font: 600 0.75rem/1 var(--font-head); color: var(--ok); background: var(--ok-soft); padding: 0.35rem 0.6rem; border-radius: 99px; }
  .card h3 { position: relative; font-size: 1.2rem; line-height: 1.55; padding-inline-end: 3.2rem; }
  .title { color: var(--ink); text-decoration: none; }
  .card .en { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.82rem; }
  .blurb { margin: 0.6rem 0 0; color: var(--muted); font-size: 0.98rem; line-height: 1.8; }
  .foot { margin-top: auto; padding-top: 0.9rem; display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--muted); font-family: var(--font-head); }

  /* البطاقات القادمة: البطاقة كلها رابط */
  .card.soon .title::after { content: ''; position: absolute; inset: -10rem; }
  .card.soon { background: color-mix(in srgb, var(--surface) 55%, var(--paper)); }
  .card.soon:hover { border-color: var(--muted); }
  .card.soon h3 { color: var(--muted); }

  /* الفصل الجاهز: بطاقة عريضة */
  .card.ready {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-rows: auto auto auto 1fr auto;
    column-gap: 2.5rem;
    padding: 1.6rem 1.8rem 1.4rem;
    border: 2px solid var(--accent);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--surface);
  }
  .card.ready .num { color: var(--accent); }
  .card.ready h3 { font-size: 1.9rem; max-width: none; }
  .card.ready .title:hover { color: var(--accent); }
  .card.ready .blurb { color: var(--ink); max-width: 46ch; }
  .card.ready > :not(.secs):not(.num) { grid-column: 1; }
  .card.ready .secs { grid-column: 2; grid-row: 1 / -1; align-self: center; margin: 0; }
  .card.ready .num { inset-inline-end: 1rem; bottom: -1.4rem; top: auto; opacity: 0.08; font-size: 12rem; }
  .card.ready .foot { grid-row: 5; }
  .secs {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1rem;
  }
  .secs a {
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-s);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.5;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }
  .secs a:hover { background: var(--accent-soft); }
  .secs .sid { font: 600 0.8rem var(--font-en); color: var(--accent); min-width: 1.8rem; padding-top: 0.15rem; }
  .secs .is-done .sid::after { content: ' ✓'; color: var(--ok); }
  .foot .bar { flex: 1; max-width: 220px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .hero-plot { max-width: 340px; }
  }
  @media (max-width: 900px) {
    .card.ready { grid-template-columns: 1fr; grid-template-rows: none; padding: 1.3rem; }
    .card.ready .secs { grid-column: 1; grid-row: auto; margin-top: 1rem; }
    .card.ready .foot { grid-row: auto; }
    .card.ready .num { font-size: 7rem; }
  }
  @media (max-width: 560px) {
    .secs { grid-template-columns: 1fr; }
    .card { min-height: 0; }
    .num { font-size: 3.2rem; }
  }
</style>
