---
import Frame from './Frame.astro';
---
<Frame id="w-rad" title="الراديان وطول القوس ومساحة القطاع" en="Radians, arc length, sector area">
  <div class="controls">
    <label>الزاوية <span class="ltr">θ = <output data-o="t"></output></span><input type="range" min="0" max="24" value="5" data-i="t" /></label>
    <label>نصف القطر <span class="ltr">r = <output data-o="r"></output></span><input type="range" min="1" max="10" value="4" data-i="r" /></label>
  </div>
  <canvas aria-label="دائرة وقطاع وقوس"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt, piLabel } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-rad')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -1.6, xmax: 1.6, ymin: -1.2, ymax: 1.2 });
  const v = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!.value);
  const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
  function draw() {
    const k = v('t'), r = v('r');
    const th = (k * Math.PI) / 12;
    const g = gcd(k, 12) || 1;
    const n = k / g, d = 12 / g;
    const thT = k === 0 ? '0' : d === 1 ? `${n === 1 ? '' : n}\\pi` : `\\dfrac{${n === 1 ? '' : n}\\pi}{${d}}`;
    root.querySelector('[data-o="t"]')!.textContent = k === 0 ? '0' : piLabel(k, 12);
    root.querySelector('[data-o="r"]')!.textContent = String(r);
    plot.fit(0.6);
    const half = 1.25 / 0.6;
    plot.view = { xmin: -half, xmax: half, ymin: -1.25, ymax: 1.25 };
    plot.clear();
    const { ctx } = plot;
    // القطاع
    ctx.fillStyle = css('--accent-soft');
    ctx.beginPath();
    ctx.moveTo(plot.X(0), plot.Y(0));
    for (let j = 0; j <= 80; j++) { const u = (th * j) / 80; ctx.lineTo(plot.X(Math.cos(u)), plot.Y(Math.sin(u))); }
    ctx.closePath();
    ctx.fill();
    plot.param(Math.cos, Math.sin, 0, 2 * Math.PI, css('--muted'), 1.5);
    plot.param(Math.cos, Math.sin, 0, th, css('--plot-hot'), 5);
    plot.seg(0, 0, 1, 0, css('--plot-alt'), 2.5);
    plot.seg(0, 0, Math.cos(th), Math.sin(th), css('--plot-alt'), 2.5);
    // علامات الراديان الكاملة: أقواس بطول r
    for (let j = 1; j <= 6; j++) {
      plot.dot(Math.cos(j), Math.sin(j), css('--plot-curve'), 3.5);
      plot.label(1.13 * Math.cos(j), 1.13 * Math.sin(j) - 0.06, String(j), css('--plot-curve'), 'center');
    }
    plot.param((u) => 0.18 * Math.cos(u), (u) => 0.18 * Math.sin(u), 0, th, css('--ink'), 1.5);
    const s = r * th, A = 0.5 * r * r * th;
    const deg = k * 15;
    out.innerHTML =
      `<p>${tex(`$\\theta = ${thT} \\approx ${fmt(th, 4)}$`)} راديان، وبالدرجات: ${tex(`$${thT} \\cdot \\dfrac{180^\\circ}{\\pi} = ${deg}^\\circ$`)}</p>` +
      `<p>طول القوس (الأحمر): ${tex(`$s = r\\theta = ${r} \\cdot ${fmt(th, 4)} \\approx ${fmt(s, 3)}$`)}</p>` +
      `<p>مساحة القطاع: ${tex(`$A = \\tfrac{1}{2}r^2\\theta = \\tfrac12(${r})^2(${fmt(th, 4)}) \\approx ${fmt(A, 3)}$`)}</p>` +
      `<p>النقاط المرقّمة على الدائرة تبعد عن نقطة البداية قوسًا طوله ${tex('$1, 2, 3, \\dots$')} أنصاف أقطار. الراديان الواحد هو الزاوية التي يقابلها قوس طوله يساوي نصف القطر، والدورة الكاملة ${tex('$2\\pi \\approx 6.28$')} راديان.</p>`;
  }
  root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
  onRedraw(canvas, draw);
</script>
