---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="الصفحة غير موجودة">
  <div style="max-width:640px;margin:0 auto;padding:4rem 1rem;text-align:center">
    <p style="font:700 4rem var(--font-en);color:var(--accent);margin:0">404</p>
    <h1>لم نجد هذه الصفحة</h1>
    <p>ربما تغيّر الرابط أو أن الدرس لم يُنشر بعد.</p>
    <a class="btn primary" href={base}>اذهب إلى خريطة الفصول</a>
  </div>
</Base>
