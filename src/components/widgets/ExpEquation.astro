---
import Frame from './Frame.astro';
---
<Frame id="w-ee" title="حل معادلة أسية بالرسم وباللوغاريتم" en="Solving a·bˣ = c">
  <div class="controls">
    <label><span class="ltr">a = <output data-o="a"></output></span><input type="range" min="1" max="5" value="2" data-i="a" /></label>
    <label><span class="ltr">b = <output data-o="b"></output></span><input type="range" min="0.5" max="4" step="0.5" value="3" data-i="b" /></label>
    <label><span class="ltr">c = <output data-o="c"></output></span><input type="range" min="-2" max="20" step="1" value="11" data-i="c" /></label>
  </div>
  <canvas aria-label="تقاطع المنحنى الأسي مع مستقيم أفقي"></canvas>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { Plot, onRedraw, css, fmt } from '../../lib/plot';
  import { tex } from '../../lib/tex';
  const root = document.getElementById('w-ee')!;
  const canvas = root.querySelector('canvas')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const plot = new Plot(canvas, { xmin: -5, xmax: 5, ymin: -3, ymax: 22 });
  const v = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!.value);
  function draw() {
    const a = v('a'), c = v('c');
    let b = v('b');
    if (b === 1) b = 1.5;
    for (const s of ['a', 'c']) root.querySelector(`[data-o="${s}"]`)!.textContent = String(v(s));
    root.querySelector('[data-o="b"]')!.textContent = String(b);
    plot.fit(0.55);
    plot.clear();
    plot.grid(1, 1, 2);
    plot.fn((x) => a * b ** x, css('--plot-curve'), 3);
    plot.seg(-5, c, 5, c, css('--plot-alt'), 2.2);
    const eq = `${a === 1 ? '' : a + '\\cdot '}${b}^x = ${c}`;
    if (c <= 0) {
      out.innerHTML = `<p>${tex(`$${eq}$`)} <strong>لا حل لها</strong>: ${tex(`$${a === 1 ? '' : a}${b}^x$`)} موجبة دائمًا، فالمنحنى لا يلمس المستقيم ${tex(`$y = ${c}$`)} أبدًا. ولو حاولت أخذ اللوغاريتم لوصلت إلى ${tex(`$\\ln(${c === 0 ? 0 : fmt(c / a, 3)})$`)}، وهو غير معرّف.</p>`;
      return;
    }
    const x = Math.log(c / a) / Math.log(b);
    plot.dot(x, c, css('--plot-hot'), 7);
    plot.seg(x, 0, x, c, css('--plot-hot'), 1.5, [4, 3]);
    out.innerHTML =
      `<p>${tex(`$${eq}$`)}</p>` +
      `<p>1) اعزل الأس: ${tex(`$${b}^x = ${a === 1 ? c : `\\dfrac{${c}}{${a}}`}$`)}</p>` +
      `<p>2) خذ ${tex('$\\ln$')} للطرفين وأنزل الأس: ${tex(`$x \\ln ${b} = \\ln ${a === 1 ? c : `\\tfrac{${c}}{${a}}`}$`)}</p>` +
      `<p>3) اقسم: ${tex(`$x = \\dfrac{\\ln ${a === 1 ? c : `(${c}/${a})`}}{\\ln ${b}} \\approx ${fmt(x, 4)}$`)} وهو الإحداثي x لنقطة التقاطع.</p>`;
  }
  root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
  onRedraw(canvas, draw);
</script>
