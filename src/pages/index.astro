---
import Base from '../layouts/Base.astro';
import { chapters, lessonSlug } from '../data/curriculum';
const base = import.meta.env.BASE_URL;
const readyIds = chapters.filter((c) => c.status === 'ready').flatMap((c) => c.sections.map((s) => s.id));
---
<Base title="الجبر الجامعي وعلم المثلثات | شرح عربي تفاعلي">
  <section class="hero">
    <div class="hero-text">
      <h1>الجبر الجامعي وعلم المثلثات، مشروحًا بالعربية خطوة بخطوة</h1>
      <p class="lede">
        كل قسم من الكتاب درس مستقل: شرح بالحدس أولًا، ثم القاعدة، ثم أمثلة يُكشف حلها خطوة خطوة، وأداة تفاعلية تحرّك فيها المعاملات وترى أثرها،
        وتمارين جديدة في كل مرة تُصحَّح فورًا. المصطلحات مكتوبة بالعربية والإنجليزية معًا لتقرأ الكتاب الأصلي بسهولة.
      </p>
      <div class="cta" data-progress-wrap>
        <a class="btn primary" href={`${base}lessons/${lessonSlug(readyIds[0])}/`} data-continue={readyIds.join(',')}>ابدأ الفصل الأول</a>
        <a class="btn" href={`${base}glossary/`}>قائمة المصطلحات</a>
        <span class="prog">
          <span class="bar" data-progress-bar><i></i></span>
          <span>أنهيت <span data-progress-count={readyIds.join(',')}>0 من {readyIds.length}</span> دروس</span>
        </span>
      </div>
    </div>
    <svg class="hero-plot" viewBox="0 0 320 240" role="img" aria-label="قطع مكافئ يقطع محور x في نقطتين">
      <defs>
        <pattern id="g" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="var(--line)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="320" height="240" fill="url(#g)" />
      <path d="M0 160H320M100 0V240" stroke="var(--muted)" stroke-width="1.5" />
      <path class="curve" d="M30 20 Q160 300 290 20" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" />
      <path d="M0 200 L320 40" fill="none" stroke="var(--def)" stroke-width="2" stroke-dasharray="7 6" />
      <circle cx="68" cy="160" r="6" fill="var(--plot-hot)" />
      <circle cx="252" cy="160" r="6" fill="var(--plot-hot)" />
      <text x="160" y="232" text-anchor="middle" font-family="Noto Sans" font-size="14" fill="var(--muted)" direction="ltr">b² − 4ac &gt; 0</text>
    </svg>
  </section>

  <section class="map" aria-labelledby="map-h">
    <h2 id="map-h">خريطة الكتاب</h2>
    <p class="map-note">الفصول على محور واحد بترتيب الكتاب. الفصل الأول جاهز الآن، والبقية تُضاف تباعًا.</p>
    <ol class="axis">
      {chapters.map((ch) => (
        <li class={`ch ${ch.status}`}>
          <span class="tick" aria-hidden="true"></span>
          <span class="cid" aria-hidden="true">{ch.id}</span>
          <div class="cbody">
            <h3>
              <a href={`${base}chapters/${ch.id}/`}>{ch.ar}</a>
              {ch.status === 'soon' && <span class="tag-soon">قريبًا</span>}
            </h3>
            <p class="en" lang="en" dir="ltr">{ch.en}</p>
            <p class="blurb">{ch.blurb}</p>
            <p class="count">{ch.sections.length} أقسام</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <script>
    import { getProgress, paintProgress } from '../lib/progress';
    paintProgress();
    const a = document.querySelector<HTMLAnchorElement>('[data-continue]');
    if (a) {
      const ids = a.dataset.continue!.split(',');
      const p = getProgress();
      const done = ids.filter((id) => p[id]).length;
      const nextId = ids.find((id) => !p[id]);
      if (done > 0 && nextId) {
        a.href = a.href.replace(/lessons\/[^/]+\/$/, `lessons/${nextId.replace('.', '-')}/`);
        a.textContent = `تابع من ${nextId}`;
      } else if (done === ids.length) a.textContent = 'راجع الفصل الأول';
    }
  </script>
</Base>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4.5rem) 1rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3rem); line-height: 1.45; max-width: 18ch; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 58ch; margin: 1.2rem 0 1.6rem; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .prog { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: var(--muted); }
  .bar { width: 90px; height: 6px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--ok); }
  .hero-plot { width: 100%; max-width: 420px; justify-self: center; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); }
  .curve { stroke-dasharray: 520; stroke-dashoffset: 520; animation: draw 1.6s 0.2s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  .map { max-width: 1000px; margin: 0 auto; padding: 2rem 1rem 0; }
  .map > h2 { margin-bottom: 0.3rem; }
  .map-note { color: var(--muted); margin: 0 0 2rem; }
  .axis { list-style: none; margin: 0; padding: 0; position: relative; }
  .axis::before {
    content: '';
    position: absolute;
    inset-block: 0.8rem;
    inset-inline-start: 4.6rem;
    border-inline-start: 2px solid var(--line);
  }
  .ch {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1.2rem minmax(0, 1fr);
    column-gap: 0;
    padding: 0.9rem 0;
  }
  .cid {
    grid-column: 1;
    grid-row: 1;
    font: 700 2rem/1.2 var(--font-en);
    color: var(--muted);
    text-align: center;
    opacity: 0.55;
  }
  .tick {
    grid-column: 2;
    grid-row: 1;
    width: 14px;
    height: 14px;
    margin-top: 0.9rem;
    margin-inline-start: 0.08rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--line);
    z-index: 1;
  }
  .cbody { grid-column: 3; grid-row: 1; padding-inline-start: 1.2rem; }
  .ch h3 { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; font-size: 1.25rem; }
  .ch h3 a { color: var(--ink); text-decoration: none; }
  .ch h3 a:hover { color: var(--accent); }
  .ch .en { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .blurb { margin: 0.3rem 0 0; color: var(--muted); max-width: 60ch; }
  .count { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--muted); font-family: var(--font-head); }
  .ch.soon .cbody { opacity: 0.78; }

  .ch.ready { padding: 1.4rem 0; }
  .ch.ready .cid { color: var(--accent); opacity: 1; font-size: 3rem; }
  .ch.ready .tick { background: var(--accent); border-color: var(--accent); width: 18px; height: 18px; margin-top: 1.3rem; box-shadow: 0 0 0 6px var(--accent-soft); }
  .ch.ready h3 { font-size: 1.6rem; }
  .ch.ready .blurb { color: var(--ink); }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .hero-plot { max-width: 340px; }
    .axis::before { inset-inline-start: 3.55rem; }
    .ch { grid-template-columns: 3rem 1.2rem minmax(0, 1fr); }
    .cid { font-size: 1.5rem; }
    .ch.ready .cid { font-size: 2.2rem; }
  }
</style>
