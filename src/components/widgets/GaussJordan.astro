---
import Frame from './Frame.astro';
---
<Frame id="w-gj" title="طريقة غاوس-جوردان خطوة بخطوة" en="Row reduction to reduced row echelon form">
  <div class="controls">
    <label>النظام
      <select data-i="p">
        <option value="0">3 معادلات بحل وحيد</option>
        <option value="1">2 معادلتان بحل وحيد</option>
        <option value="2">نظام غير متسق</option>
        <option value="3">نظام معتمد (حلول لا نهائية)</option>
      </select>
    </label>
    <label>الخطوة <span class="ltr"><output data-o="k"></output></span>
      <span class="seg" dir="ltr"><button type="button" data-i="prev">‹ السابقة</button><button type="button" data-i="next">التالية ›</button></span>
    </label>
  </div>
  <div class="mat" dir="ltr"></div>
  <div class="readout" aria-live="polite"></div>
</Frame>
<script>
  import { tex } from '../../lib/tex';
  import { q, add, mul, div, isZero, qTex, matTex, type Q } from '../../lib/frac';
  const root = document.getElementById('w-gj')!;
  const box = root.querySelector<HTMLElement>('.mat')!;
  const out = root.querySelector<HTMLElement>('.readout')!;
  const SYS: number[][][] = [
    [[1, 1, 1, 6], [2, -1, 1, 3], [1, 2, -1, 2]],
    [[3, 2, 7], [1, -4, 0]],
    [[1, 1, 2], [2, 2, 5]],
    [[1, 2, -1, 3], [2, 4, -2, 6], [1, -1, 2, 0]],
  ];
  type Step = { m: Q[][]; op: string };
  function steps(A0: number[][]): Step[] {
    let m: Q[][] = A0.map((r) => r.map((x) => q(x)));
    const res: Step[] = [{ m, op: 'المصفوفة الموسّعة للنظام' }];
    const rows = m.length, cols = m[0].length - 1;
    let r = 0;
    for (let c = 0; c < cols && r < rows; c++) {
      let p = r;
      while (p < rows && isZero(m[p][c])) p++;
      if (p === rows) continue;
      if (p !== r) { m = m.map((row) => row.slice()); [m[p], m[r]] = [m[r], m[p]]; res.push({ m, op: `بدّل الصفين $R_{${r + 1}} \\leftrightarrow R_{${p + 1}}$` }); }
      const piv = m[r][c];
      if (!(piv.n === 1 && piv.d === 1)) {
        m = m.map((row) => row.slice()); m[r] = m[r].map((x) => div(x, piv));
        res.push({ m, op: `اجعل المحور 1: $R_{${r + 1}} \\to ${qTex(div(q(1), piv))}R_{${r + 1}}$` });
      }
      for (let i = 0; i < rows; i++) {
        if (i === r || isZero(m[i][c])) continue;
        const f = m[i][c];
        m = m.map((row) => row.slice());
        m[i] = m[i].map((x, j) => add(x, mul(q(-f.n, f.d), m[r][j])));
        const fn = q(-f.n, f.d);
        res.push({ m, op: `صفّر العنصر: $R_{${i + 1}} \\to R_{${i + 1}} ${fn.n < 0 ? '-' : '+'} ${qTex(q(Math.abs(fn.n), fn.d)) === '1' ? '' : qTex(q(Math.abs(fn.n), fn.d))}R_{${r + 1}}$` });
      }
      r++;
    }
    return res;
  }
  let all: Step[] = [], k = 0;
  const sel = root.querySelector<HTMLSelectElement>('[data-i="p"]')!;
  function load() { all = steps(SYS[Number(sel.value)]); k = 0; show(); }
  function verdict(m: Q[][]): string {
    const cols = m[0].length - 1;
    for (const row of m) if (row.slice(0, cols).every(isZero) && !isZero(row[cols])) return `صف على صورة ${tex('$[0 \\ 0 \\cdots 0 \\mid c]$')} مع ${tex('$c \\ne 0$')} يعني ${tex(`$0 = ${qTex(row[cols])}$`)}: <strong>لا حل</strong>.`;
    const nz = m.filter((row) => !row.slice(0, cols).every(isZero)).length;
    if (nz < cols) return `عدد الصفوف غير الصفرية (${nz}) أقل من عدد المجاهيل (${cols})، فهناك متغير حر: <strong>عدد لا نهائي من الحلول</strong>.`;
    const names = ['x', 'y', 'z', 'w'];
    return `<strong>الحل الوحيد</strong>: ${tex(`$${m.map((row, i) => `${names[i]} = ${qTex(row[cols])}`).join(',\\ ')}$`)}`;
  }
  function show() {
    const s = all[k];
    root.querySelector('[data-o="k"]')!.textContent = `${k} / ${all.length - 1}`;
    box.innerHTML = tex(`$$${matTex(s.m, true)}$$`);
    out.innerHTML = `<p>${s.op.replace(/\$([^$]+)\$/g, (_m, t) => tex(`$${t}$`))}</p>` + (k === all.length - 1 ? `<p>${verdict(s.m)}</p>` : '<p>اضغط «التالية» لتطبيق العملية التالية على الصفوف.</p>');
  }
  root.querySelector('[data-i="next"]')!.addEventListener('click', () => { if (k < all.length - 1) { k++; show(); } });
  root.querySelector('[data-i="prev"]')!.addEventListener('click', () => { if (k > 0) { k--; show(); } });
  sel.addEventListener('change', load);
  load();
</script>
<style>
  .mat { min-height: 7rem; display: grid; place-items: center; font-size: 1.2rem; overflow-x: auto; }
</style>
