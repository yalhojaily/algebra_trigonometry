---
// إطار موحّد للأدوات التفاعلية
interface Props { title: string; en: string; id: string }
const { title, en, id } = Astro.props;
---
<figure class="widget" id={id}>
  <figcaption>
    <span class="kicker">جرّب بنفسك</span>
    <strong>{title}</strong>
    <span class="en" lang="en" dir="ltr">{en}</span>
  </figcaption>
  <div class="wbody"><slot /></div>
</figure>
<style>
  .widget {
    margin: 2.2rem 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.7rem 1.2rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-head);
  }
  .kicker { font-size: 0.8rem; color: var(--accent); font-weight: 700; }
  figcaption .en { color: var(--muted); }
  .wbody { padding: 1rem 1.2rem 1.2rem; }
  .wbody :global(canvas) { display: block; width: 100%; border-radius: var(--radius-s); background: var(--paper); }
  .wbody :global(.controls) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.4rem 1.2rem;
    margin-bottom: 0.9rem;
  }
  .wbody :global(.controls label) { display: block; font-size: 0.95rem; }
  .wbody :global(.controls output) { font-family: var(--font-en); font-weight: 600; direction: ltr; unicode-bidi: isolate; }
  .wbody :global(.readout) {
    margin-top: 0.8rem;
    padding: 0.6rem 0.9rem;
    background: var(--paper);
    border-radius: var(--radius-s);
    font-size: 1rem;
    line-height: 1.9;
  }
  .wbody :global(.readout p) { margin: 0.15rem 0; }
  .wbody :global(.seg) { display: inline-flex; border: 1px solid var(--line); border-radius: var(--radius-s); overflow: hidden; }
  .wbody :global(.seg button) {
    font: 600 1rem var(--font-en);
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .wbody :global(.seg button[aria-pressed='true']) { background: var(--accent); color: var(--accent-ink); }
  .wbody :global(.legend) { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.9rem; color: var(--muted); margin-top: 0.4rem; }
  .wbody :global(.legend i) { display: inline-block; width: 18px; height: 3px; vertical-align: middle; margin-inline-end: 0.35rem; border-radius: 2px; }
</style>
